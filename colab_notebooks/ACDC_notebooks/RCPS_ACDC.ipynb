        "RCPS_ROOT = \"/content/RCPS\"\n",
        "DRIVE_ACDC_DIR = \"/content/drive/MyDrive/Datasets/ACDC\"\n",
        "\n",
        "# Get all cases from Drive ACDC/data folder\n",
        "H5_SOURCE = os.path.join(DRIVE_ACDC_DIR, \"data\")\n",
        "\n",
        "if not os.path.exists(H5_SOURCE):\n",
        "    print(f\"\u274c ACDC data not found at: {H5_SOURCE}\")\n",
        "    print(\"\\nPlease ensure your ACDC dataset has this structure:\")\n",
        "    print(\"  Drive/Datasets/ACDC/\")\n",
        "    print(\"    \u2514\u2500\u2500 data/\")\n",
        "    print(\"        \u251c\u2500\u2500 patient001_frame01.h5\")\n",
        "    print(\"        \u251c\u2500\u2500 patient001_frame12.h5\")\n",
        "    print(\"        \u2514\u2500\u2500 ...\")\n",
        "else:\n",
        "    # Get all .h5 files\n",
        "    all_cases = sorted([f.replace('.h5', '') for f in os.listdir(H5_SOURCE) \n",
        "                       if f.endswith('.h5')])\n",
        "    \n",
        "    print(f\"\u2713 Found {len(all_cases)} ACDC cases\")\n",
        "    print(f\"  First: {all_cases[0]}\")\n",
        "    print(f\"  Last:  {all_cases[-1]}\\n\")\n",
        "    \n",
        "    # ACDC standard split: 70 train / 30 val\n",
        "    # Use fixed seed for reproducibility\n",
        "    random.seed(1337)\n",
        "    random.shuffle(all_cases)\n",
        "    \n",
        "    # Split into train/val (70/30 split is common for ACDC)\n",
        "    split_idx = int(len(all_cases) * 0.7)  # 70% for training\n",
        "    train_cases = sorted(all_cases[:split_idx])\n",
        "    val_cases = sorted(all_cases[split_idx:])\n",
        "    \n",
        "    print(f\"Split: {len(train_cases)} train / {len(val_cases)} val\\n\")\n",
        "    \n",
        "    # Create ACDC data directory in RCPS\n",
        "    ACDC_LIST_DIR = f\"{RCPS_ROOT}/data/ACDC\"\n",
        "    os.makedirs(ACDC_LIST_DIR, exist_ok=True)\n",
        "    \n",
        "    # Save train.list\n",
        "    TRAIN_LIST = f\"{ACDC_LIST_DIR}/train.list\"\n",
        "    with open(TRAIN_LIST, 'w') as f:\n",
        "        f.write('\\n'.join(train_cases) + '\\n')\n",
        "    \n",
        "    print(f\"\u2713 Created: {TRAIN_LIST}\")\n",
        "    print(f\"  First 5: {train_cases[:5]}\")\n",
        "    \n",
        "    # Save val.list\n",
        "    VAL_LIST = f\"{ACDC_LIST_DIR}/val.list\"\n",
        "    with open(VAL_LIST, 'w') as f:\n",
        "        f.write('\\n'.join(val_cases) + '\\n')\n",
        "    \n",
        "    print(f\"\\n\u2713 Created: {VAL_LIST}\")\n",
        "    print(f\"  First 5: {val_cases[:5]}\")\n",
        "    \n",
        "    print(\"\\n\" + \"=\"*70)\n",
        "    print(\"\u2705 Dataset splits created successfully!\")\n",
