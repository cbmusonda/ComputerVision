      "cell_type": "code",
      "source": [
        "import os\n",
        "import numpy as np\n",
        "import nibabel as nib\n",
        "import pandas as pd\n",
        "from scipy import ndimage\n",
        "from medpy import metric\n",
        "\n",
        "print(\"=\"*70)\n",
        "print(\"COMPREHENSIVE EVALUATION\")\n",
        "print(\"=\"*70 + \"\\n\")\n",
        "\n",
        "# Paths\n",
        "TASK = \"acdc\"\n",
        "EXP_NAME = \"acdc_colab_400epochs-task_acdc-ratio_0.1\"\n",
        "\n",
        "PRED_DIR = f\"/content/RCPS/experiments/inference_display/{TASK}/{EXP_NAME}\"\n",
        "GT_DIR = \"/content/RCPS/data/ACDC_rcps/val_labels\"\n",
        "\n",
        "if not os.path.exists(PRED_DIR):\n",
        "    print(f\"\u274c Predictions not found: {PRED_DIR}\")\n",
        "    print(\"\\nRun training first, then inference will be generated automatically.\")\n",
        "else:\n",
        "    print(f\"\u2713 Found predictions at: {PRED_DIR}\\n\")\n",
        "    \n",
        "    # Get all prediction files\n",
        "    pred_files = sorted([f for f in os.listdir(PRED_DIR) if f.endswith('_pred.nii.gz')])\n",
        "    print(f\"Total predictions: {len(pred_files)}\\n\")\n",
        "    \n",
        "    # Calculate metrics for each class\n",
        "    results = []\n",
        "    \n",
        "    for pred_file in pred_files:\n",
        "        case_id = pred_file.replace('_pred.nii.gz', '')\n",
        "        \n",
        "        # Load prediction and ground truth\n",
        "        pred = nib.load(os.path.join(PRED_DIR, pred_file)).get_fdata()\n",
        "        gt = nib.load(os.path.join(GT_DIR, f\"{case_id}.nii.gz\")).get_fdata()\n",
        "        \n",
        "        # Calculate metrics for each class (1: RV, 2: Myo, 3: LV)\n",
        "        case_metrics = {'case': case_id}\n",
        "        \n",
        "        for class_id in [1, 2, 3]:\n",
        "            pred_class = (pred == class_id).astype(np.uint8)\n",
        "            gt_class = (gt == class_id).astype(np.uint8)\n",
        "            \n",
        "            if pred_class.sum() == 0 and gt_class.sum() == 0:\n",
        "                dice = 1.0\n",
        "                hd95 = 0.0\n",
        "            elif pred_class.sum() == 0 or gt_class.sum() == 0:\n",
        "                dice = 0.0\n",
        "                hd95 = 0.0\n",
        "            else:\n",
        "                try:\n",
        "                    dice = metric.binary.dc(pred_class, gt_class)\n",
        "                    hd95 = metric.binary.hd95(pred_class, gt_class)\n",
        "                except:\n",
        "                    dice = 0.0\n",
        "                    hd95 = 0.0\n",
        "            \n",
        "            case_metrics[f'dice_class{class_id}'] = dice\n",
        "            case_metrics[f'hd95_class{class_id}'] = hd95\n",
        "        \n",
        "        # Mean across classes\n",
        "        case_metrics['mean_dice'] = np.mean([case_metrics[f'dice_class{i}'] for i in [1,2,3]])\n",
