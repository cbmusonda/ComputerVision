      "cell_type": "code",
      "source": [
        "import os\n",
        "import h5py\n",
        "import nibabel as nib\n",
        "import numpy as np\n",
        "from tqdm import tqdm\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"PREPROCESSING ACDC DATASET FOR RCPS\")\n",
        "print(\"=\"*70 + \"\\n\")\n",
        "\n",
        "# Paths\n",
        "ACDC_BASE = f\"{RCPS_ROOT}/data/ACDC\"\n",
        "H5_ROOT = os.path.join(ACDC_BASE, \"data\")\n",
        "ACDC_RCPS_ROOT = f\"{RCPS_ROOT}/data/ACDC_rcps\"\n",
        "\n",
        "# Clean and create output directories\n",
        "!rm -rf \"$ACDC_RCPS_ROOT\"\n",
        "for sub in [\"train_images\", \"train_labels\", \"val_images\", \"val_labels\"]:\n",
        "    os.makedirs(os.path.join(ACDC_RCPS_ROOT, sub), exist_ok=True)\n",
        "\n",
        "def convert_split(list_path, img_out_dir, lbl_out_dir):\n",
        "    \"\"\"\n",
        "    Convert H5 files to NIfTI format for RCPS\n",
        "    \"\"\"\n",
        "    print(f\"\\nProcessing {os.path.basename(list_path)}...\")\n",
        "    \n",
        "    with open(list_path) as f:\n",
        "        cases = [l.strip() for l in f if l.strip()]\n",
        "    \n",
        "    print(f\"  Total cases: {len(cases)}\")\n",
        "    \n",
        "    missing = 0\n",
        "    for case_id in tqdm(cases, desc=\"Converting\"):\n",
        "        h5_path = os.path.join(H5_ROOT, f\"{case_id}.h5\")\n",
        "        \n",
        "        if not os.path.exists(h5_path):\n",
        "            print(f\"  \u26a0\ufe0f  Missing: {case_id}.h5\")\n",
        "            missing += 1\n",
        "            continue\n",
        "        \n",
        "        try:\n",
        "            # Load H5 file\n",
        "            with h5py.File(h5_path, 'r') as f:\n",
        "                image = f['image'][:].astype(np.float32)\n",
        "                label = f['label'][:].astype(np.uint8)\n",
        "            \n",
        "            # Save as NIfTI\n",
        "            img_nii = nib.Nifti1Image(image, affine=np.eye(4))\n",
        "            lbl_nii = nib.Nifti1Image(label, affine=np.eye(4))\n",
        "            \n",
        "            nib.save(img_nii, os.path.join(img_out_dir, f\"{case_id}.nii.gz\"))\n",
        "            nib.save(lbl_nii, os.path.join(lbl_out_dir, f\"{case_id}.nii.gz\"))\n",
        "            \n",
        "        except Exception as e:\n",
        "            print(f\"  \u274c Error with {case_id}: {e}\")\n",
        "            continue\n",
        "    \n",
        "    if missing > 0:\n",
        "        print(f\"  \u26a0\ufe0f  {missing} files missing\")\n",
        "    print(f\"  \u2713 Processed {len(cases) - missing} cases\")\n",
        "\n",
        "# Convert training set\n",
        "convert_split(\n",
        "    TRAIN_LIST,\n",
        "    os.path.join(ACDC_RCPS_ROOT, \"train_images\"),\n",
        "    os.path.join(ACDC_RCPS_ROOT, \"train_labels\")\n",
        ")\n",
        "\n",
        "# Convert validation set\n",
        "convert_split(\n",
        "    VAL_LIST,\n",
        "    os.path.join(ACDC_RCPS_ROOT, \"val_images\"),\n",
        "    os.path.join(ACDC_RCPS_ROOT, \"val_labels\")\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"\u2705 PREPROCESSING COMPLETE\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "print(\"\\nDataset structure:\")\n",
        "!ls -lh \"$ACDC_RCPS_ROOT\"\n",
        "\n",
        "print(\"\\nSample counts:\")\n",
        "for sub in [\"train_images\", \"train_labels\", \"val_images\", \"val_labels\"]:\n",
        "    count = len(os.listdir(os.path.join(ACDC_RCPS_ROOT, sub)))\n",
        "    print(f\"  {sub}: {count} files\")"
      ],
      "metadata": {
        "id": "preprocess"
      },
      "execution_count": null,
      "outputs": []
    },
